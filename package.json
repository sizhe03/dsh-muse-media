{
  "name": "dsh-muse-media",
  "version": "1.0.1",
  "description": "Muse (muse.ai web) image and video generation for DeepSeek Harness: drives your own Chrome through CDP, keeps one profile per account, and shows this week's credit in the composer.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "muse",
    "muse.ai",
    "image-generation",
    "video-generation",
    "cdp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sizhe03/dsh-muse-media.git"
  },
  "homepage": "https://github.com/sizhe03/dsh-muse-media#readme",
  "bugs": {
    "url": "https://github.com/sizhe03/dsh-muse-media/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
